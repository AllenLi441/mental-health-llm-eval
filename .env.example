# Dedicated batch-evaluation credential. Never reuse the production app key.
EVAL_API_KEY=
EVAL_BASE_URL=https://api.deepseek.com/v1
EVAL_MODEL=deepseek-v4-flash
EVAL_THINKING=disabled
EVAL_REASONING_EFFORT=high
# Absolute path containing the licensed dataset directories listed in README.md.
EVAL_DATASETS_DIR=/absolute/path/to/datasets
# Directory containing official EmoBench EA.jsonl and EU.jsonl.
EMOBENCH_DATA_DIR=/absolute/path/to/EmoBench/data
